{
  "name": "oem-sdk-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.5.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "version:game": "node scripts/game-version.mjs",
    "validate:export": "node scripts/validate-export.mjs",
    "validate:r2": "node scripts/validate-r2.mjs",
    "dev": "node scripts/prepare-dev.mjs && vite --host 127.0.0.1",
    "build:demo": "pnpm build && node scripts/build-demo.mjs",
    "update:local": "node scripts/update-local.mjs",
    "update:demo": "node scripts/update-local.mjs --demo-only",
    "update:release": "node scripts/update-local.mjs --publish",
    "deploy:pages": "pnpm build:demo && wrangler pages deploy dist --project-name oem-sdk --branch main --commit-dirty=true",
    "prepare:data": "pnpm validate:export && node scripts/prepare-r2-upload.mjs",
    "deploy:data": "node scripts/publish-r2.mjs --apply",
    "export:atlos": "node scripts/export-atlos.mjs --include-licensed-novecento",
    "export:atlos:dev": "node scripts/export-atlos.mjs --include-licensed-novecento",
    "check": "pnpm validate:export && pnpm typecheck && pnpm test && pnpm build:demo",
    "pack:release": "pnpm build && node scripts/pack-release.mjs",
    "release:npm": "node scripts/release-npm.mjs",
    "release:check": "pnpm export:atlos && pnpm check && node scripts/pack-release.mjs"
  },
  "devDependencies": {
    "@opendfieldmap/core": "workspace:*",
    "@opendfieldmap/map": "workspace:*",
    "@opendfieldmap/react": "workspace:*",
    "@opendfieldmap/sdk": "workspace:*",
    "@types/leaflet": "1.9.16",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.85.1",
    "typescript": "~5.8.3",
    "vite": "^6.2.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.129.1"
  }
}
