{
  "status": "design-only-not-deployed",
  "resources": {
    "baseUrl": "https://data.opendfieldmap.org",
    "manifestPath": "/channels/stable.json"
  },
  "gameVersion": {
    "format": "{major}_{minor}_{patch}",
    "example": "1_5_3",
    "source": "https://launcher.hypergryph.com/api/proxy/batch_proxy",
    "requestField": "proxy_reqs[].get_latest_game_req.version",
    "requestVersionBaseline": "1.3.3",
    "responseField": "proxy_rsps[].get_latest_game_rsp.version",
    "explicitOverride": "--game-version or OEM_GAME_VERSION"
  },
  "paths": {
    "channel": "/channels/stable.json",
    "manifest": "/releases/{releaseId}/manifest.json",
    "markerPoints": "/marker/{gameVersion}/points/{subregionId}.json",
    "markerLocales": "/marker/{gameVersion}/locales/{locale}/places.json",
    "markerTypes": "/marker/{gameVersion}/types.json",
    "markerIndex": "/marker/{gameVersion}/point-index.json",
    "markerAssets": "/marker/{gameVersion}/assets/{assetPath}.webp",
    "mapLabels": "/map/{gameVersion}/labels/{regionId}.json",
    "mapBoundaries": "/map/{gameVersion}/boundaries/{regionId}.json",
    "tiles": "/tiles/{gameVersion}/{regionId}/{z}/{x}/{y}[_{floorId}].webp",
    "licensedFonts": "/fonts/novecento/{sha256}/{filename}"
  },
  "proposedResponseHeaders": {
    "channel": { "Cache-Control": "public, max-age=60, must-revalidate" },
    "immutable": { "Cache-Control": "public, max-age=31536000, immutable" },
    "all": { "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Methods": "GET, HEAD, OPTIONS" }
  },
  "deploymentGuards": {
    "changeDns": false,
    "createR2Buckets": false,
    "uploadR2Objects": false,
    "publishNovecentoFonts": false,
    "migrateAtlos": false,
    "provisionApi": false
  }
}
