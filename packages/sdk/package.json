{
  "name": "@opendfieldmap/sdk",
  "version": "0.3.0-beta",
  "description": "Embeddable Open Endfield Map widget",
  "type": "module",
  "license": "AGPL-3.0-only",
  "files": [
    "dist",
    "README.md",
